desc: JB MIDI Filter (No Octaves/Unisons)
// Autor: Javier Bravo
about: This plugin filter simultaneous octaves and/or unisons from Midi data.
slider1:1<0,1,1{Off,On}>Filter Unisons
slider2:1<0,1,1{Off,On}>Filter Octaves

@init
// Buffer para rastrear qué notas están activas actualmente
active_notes = 0; // 0-127

@block
while (midirecv(offset, msg1, msg2, msg3)) (
  status = msg1 & $xF0;
  note = msg2;
  vel = msg3;
  
  status == $x90 && vel > 0 ? (
    allow_note = 1;
    
    // Comprobar contra todas las notas activas
    check_n = 0;
    loop(128,
      active_notes[check_n] == 1 ? (
        // Lógica de Unísono
        slider1 == 1 && note == check_n ? allow_note = 0;
        
        // Lógica de Octava
        slider2 == 1 ? (
          diff = abs(note - check_n);
          diff > 0 && diff % 12 == 0 ? allow_note = 0;
        );
      );
      check_n += 1;
    );
    
    allow_note ? (
      active_notes[note] = 1;
      midisend(offset, msg1, msg2, msg3);
    );
    
  ) : (status == $x80 || (status == $x90 && vel == 0)) ? (
    active_notes[note] = 0;
    midisend(offset, msg1, msg2, msg3);
  ) : (
    // Dejar pasar CC, Pitch Bend, etc.
    midisend(offset, msg1, msg2, msg3);
  );
);
