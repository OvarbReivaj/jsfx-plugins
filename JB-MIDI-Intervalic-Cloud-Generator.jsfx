desc: JB MIDI Intervalic Cloud Generator
author: Javier Bravo
version: 1.6
about:
  # JB MIDI Intervalic Cloud Generator
  An algorithmic MIDI event generator that creates melodic streams and clusters based on an analyzed network of input intervals.
  
  ### Key Features:
  - **Intervalic Walk:** Analyzes polyphonic MIDI input to extract a "pool" of available intervals for generation.
  - **Dynamic Modes:** 
    - *Absolute:* Uses exact semitone distances.
    - *Reduced:* Constrains all intervals to within one octave.
    - *Expanded:* Inverts small intervals (< tritone) into their wide counterparts (e.g., 2nd becomes 7th) for angular, contemporary textures.
  - **Smart Octave Wrap:** Automatically transposes generated notes by octaves to stay within the user-defined pitch range.
  - **Probabilistic Engine:** Independent control over event density, duration, and chord/cluster generation.
  - **Humanization:** Built-in randomization for timing, velocity, and length to ensure organic results.
  
slider1:200<10,1000,1>Rate (ms)
slider2:0<0,500,1>Rate Deviation (ms)
slider3:100<0,100,1>Probability (%)
slider4:500<10,4000,1>Duration (ms)
slider5:0<0,2000,1>Duration Deviation (ms)
slider6:64<0,127,1>Central Velocity
slider7:20<0,64,1>Velocity Deviation
slider8:0<0,2,1{Absolute,Reduced,Expanded}>Interval Mode
slider9:36<0,127,1>Note Out Min
slider10:96<0,127,1>Note Out Max
slider11:50<10,200,1>Input Window (ms)
slider12:20<0,100,1>Chord Prob (%)
slider13:3<1,5,1>Max Chord Size
slider14:0<0,200,1>Active Intervals Count

@init
notes_buffer = 0;        
intervals_buf = 200;     
off_buffer_pitch = 400;  
off_buffer_time = 600;   

max_pending_notes = 128;
num_intervals = 0;
last_gen_pitch = -1;
window_samples = 0;
is_collecting = 0;
need_recalc = 0;

function update_intervals() (
  num_intervals = 0;
  i = 0;
  loop(128, 
    notes_buffer[i] ? (
      j = i + 1;
      loop(128 - j,
        notes_buffer[j] ? (
          diff = j - i;
          
          slider8 == 1 ? ( // Reduced
            diff = diff % 12;
            diff == 0 ? diff = 12;
          ) : slider8 == 2 ? ( // Expanded
            abs_diff = abs(diff % 12);
            abs_diff > 0 && abs_diff < 6 ? (
              diff = (12 - abs_diff) * (diff > 0 ? 1 : -1);
            );
          );

          num_intervals < 200 ? (
            intervals_buf[num_intervals] = diff;
            intervals_buf[num_intervals + 1] = -diff;
            num_intervals += 2;
          );
        );
        j += 1;
      );
    );
    i += 1;
  );
  slider14 = num_intervals;
);

@slider
rate_samples = (slider1 / 1000) * srate;
rate_dev_samples = (slider2 / 1000) * srate;
win_limit = (slider11 / 1000) * srate;
update_intervals();

@block
i_off = 0;
loop(max_pending_notes,
  off_buffer_time[i_off] > 0 ? (
    off_buffer_time[i_off] -= samplesblock;
    off_buffer_time[i_off] <= 0 ? (
      midisend(0, $x80, off_buffer_pitch[i_off], 0);
      off_buffer_time[i_off] = 0;
    );
  );
  i_off += 1;
);

while (midirecv(offset, msg1, msg2, msg3)) (
  status = msg1 & $xF0;
  status == $x90 && msg3 > 0 ? (
    notes_buffer[msg2] = 1;
    is_collecting = 1;
    window_samples = 0;
    last_gen_pitch == -1 ? last_gen_pitch = msg2; 
  ) : (status == $x80 || (status == $x90 && msg3 == 0)) ? (
    notes_buffer[msg2] = 0;
    need_recalc = 1;
  );
  midisend(offset, msg1, msg2, msg3); 
);

is_collecting ? (
  window_samples += samplesblock;
  window_samples >= win_limit ? (
    update_intervals();
    is_collecting = 0;
    need_recalc = 0;
  );
) : (
  need_recalc ? ( update_intervals(); need_recalc = 0; );
);

@sample
next_event_samples -= 1;

next_event_samples <= 0 ? (
  (num_intervals > 0 && rand(100) < slider3) ? (
    is_chord = (slider13 > 1 && rand(100) < slider12);
    notes_to_gen = is_chord ? (floor(rand(slider13 - 1)) + 2) : 1;
    
    temp_pitch = last_gen_pitch;
    n = 0;
    loop(notes_to_gen,
      idx = floor(rand(num_intervals));
      interval = intervals_buf[idx];
      new_pitch = temp_pitch + interval;
      
      while(new_pitch < slider9) ( new_pitch += 12; );
      while(new_pitch > slider10) ( new_pitch -= 12; );
      new_pitch = max(0, min(127, new_pitch));

      v_dev = (rand(slider7 * 2) - slider7);
      final_vel = min(127, max(1, floor(slider6 + v_dev)));
      d_dev = (rand(slider5 * 2) - slider5);
      final_dur = floor(((max(10, slider4 + d_dev)) / 1000) * srate);

      midisend(0, $x90, new_pitch, final_vel);
      
      s_idx = 0; slot_found = 0;
      loop(max_pending_notes,
        !slot_found && off_buffer_time[s_idx] <= 0 ? (
          off_buffer_pitch[s_idx] = new_pitch;
          off_buffer_time[s_idx] = final_dur;
          slot_found = 1;
        );
        s_idx += 1;
      );
      
      temp_pitch = new_pitch;
      n == 0 ? last_gen_pitch = new_pitch;
      n += 1;
    );
  );
  r_dev = (rand(rate_dev_samples * 2) - rate_dev_samples);
  next_event_samples = max(1, rate_samples + r_dev);
);
